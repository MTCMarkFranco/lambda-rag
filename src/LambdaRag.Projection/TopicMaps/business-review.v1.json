    { "id": "non_solicit",          "keywords": ["non-solicitation", "non-solicit", "no-poach"] },
    { "id": "pricing",              "keywords": ["pricing", "fee schedule", "rate card", "hourly rate", "fixed fee", "time and materials"] },
