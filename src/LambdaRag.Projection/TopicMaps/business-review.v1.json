{
  "domain": "business-review",
  "version": "1.0.0",
  "description": "Generic business document review — MOUs, LOIs, SOWs, RFP responses, partnership agreements, joint ventures, project charters, ADRs. Used when no industry-specific topic map applies. Use cases: scope/SLA gap analysis, RFP compliance review, MOU red-flag detection, ADR completeness check.",
  "topics": [
    { "id": "scope_of_work",        "keywords": ["scope of work", "sow", "statement of work", "deliverables list", "in scope", "out of scope"] },
    { "id": "deliverables",         "keywords": ["deliverable", "artifact", "work product", "acceptance criteria"] },
