  "axes": {
    "doc_type": {
      "headingPatterns": [
        "memorandum of understanding","mou","letter of intent","loi","statement of work","sow","master services agreement","msa","master agreement","request for proposal","rfp","request for information","rfi","architecture decision record","adr","project charter","term sheet","heads of terms","data processing agreement","dpa"
      ]
    }
  },
  "amendmentPatterns": [
    "(?i)(?:replace|supplement|amend)\\s+(?:section|article|clause|exhibit|appendix|schedule)\\s+\\d+\\w*\\s+titled\\s+[\"'\u201C]([^\"'\u201D]+)[\"'\u201D]",
    "(?i)(?:exhibit|appendix|schedule)\\s+[A-Z]\\s*[-:]?\\s*([A-Za-z][A-Za-z\\s]+)"
  ]
}
