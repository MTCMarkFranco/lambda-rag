{
  "name": "lambda-rag-rules-skillset",
  "description": "Layout → Split → WebApiSkill (extract-rule Function) → Embedding(concepts).",
  "skills": [
    {
      "@odata.type": "#Microsoft.Skills.Util.DocumentIntelligenceLayoutSkill",
      "name": "layout",
      "description": "Extracts structured text + heading hierarchy from policy PDFs.",
      "context": "/document",
      "outputMode": "oneToMany",
      "markdownHeaderDepth": "h3",
      "inputs": [
        { "name": "file_data", "source": "/document/file_data" }
      ],
      "outputs": [
        { "name": "markdown_document", "targetName": "layoutMarkdown" }
      ]
    },
    {
      "@odata.type": "#Microsoft.Skills.Text.SplitSkill",
      "name": "split",
      "description": "Section-aware split keeping headings with content.",
      "context": "/document/layoutMarkdown/*",
      "textSplitMode": "pages",
      "maximumPageLength": 3500,
      "pageOverlapLength": 200,
      "unit": "characters",
      "inputs": [
        { "name": "text", "source": "/document/layoutMarkdown/*/content" }
      ],
      "outputs": [
        { "name": "textItems", "targetName": "chunks" }
      ]
    },
    {
      "@odata.type": "#Microsoft.Skills.Custom.WebApiSkill",
      "name": "extractRule",
      "description": "Calls the extract-rule Azure Function. Each input record is a chunk and the function returns a validated ExtractedRule object.",
      "context": "/document/layoutMarkdown/*/chunks/*",
      "uri": "{{FUNCTION_URI}}",
      "httpMethod": "POST",
      "timeout": "PT60S",
      "batchSize": 1,
      "degreeOfParallelism": 4,
      "httpHeaders": {
        "x-functions-key": "{{FUNCTION_KEY}}"
      },
      "inputs": [
        { "name": "chunk",       "source": "/document/layoutMarkdown/*/chunks/*" },
        { "name": "documentId",  "source": "/document/metadata_storage_name" }
      ],
      "outputs": [
        { "name": "extractedRule", "targetName": "extractedRule" }
      ]
    },
    {
      "@odata.type": "#Microsoft.Skills.Text.AzureOpenAIEmbeddingSkill",
      "name": "embedConcepts",
      "description": "Vectorize the concept list for hybrid retrieval (Phase B).",
      "context": "/document/layoutMarkdown/*/chunks/*",
      "resourceUri": "{{AZURE_OPENAI_ENDPOINT}}",
      "deploymentId": "{{EMBEDDING_DEPLOYMENT}}",
      "modelName": "text-embedding-3-large",
      "authIdentity": null,
      "inputs": [
        { "name": "text", "source": "/document/layoutMarkdown/*/chunks/*/extractedRule/concepts" }
      ],
      "outputs": [
        { "name": "embedding", "targetName": "conceptsVector" }
      ]
    }
  ],
  "indexProjections": {
    "selectors": [
      {
        "targetIndexName": "lambda-rag-rules",
        "parentKeyFieldName": "documentId",
        "sourceContext": "/document/layoutMarkdown/*/chunks/*",
        "mappings": [
          { "name": "ruleId",          "source": "/document/layoutMarkdown/*/chunks/*/extractedRule/ruleId" },
          { "name": "domain",          "source": "='architecture-review'" },
          { "name": "version",         "source": "/document/version" },
          { "name": "status",          "source": "='draft'" },
          { "name": "naturalLanguage", "source": "/document/layoutMarkdown/*/chunks/*/extractedRule/naturalLanguage" },
          { "name": "predicate",       "source": "/document/layoutMarkdown/*/chunks/*/extractedRule/predicate" },
          { "name": "lambda",          "source": "/document/layoutMarkdown/*/chunks/*/extractedRule/lambda" },
          { "name": "concepts",        "source": "/document/layoutMarkdown/*/chunks/*/extractedRule/concepts" },
          { "name": "conceptsVector",  "source": "/document/layoutMarkdown/*/chunks/*/conceptsVector" },
          { "name": "severity",        "source": "/document/layoutMarkdown/*/chunks/*/extractedRule/severity" },
          { "name": "applicability",   "source": "/document/layoutMarkdown/*/chunks/*/extractedRule/applicability" },
          { "name": "remediation",     "source": "/document/layoutMarkdown/*/chunks/*/extractedRule/remediation" },
          { "name": "evidenceQuote",   "source": "/document/layoutMarkdown/*/chunks/*/extractedRule/evidenceQuote" },
          { "name": "sourceSpan",      "source": "/document/layoutMarkdown/*/chunks/*/extractedRule/sourceSpan" },
          { "name": "examples",        "source": "/document/layoutMarkdown/*/chunks/*/extractedRule/examples" },
          { "name": "metadata",        "source": "/document/layoutMarkdown/*/chunks/*/extractedRule/metadata" }
        ]
      }
    ],
    "parameters": {
      "projectionMode": "skipIndexingParentDocuments"
    }
  }
}
